# Copie este archivo como .env.local para desarrollo o defina las variables en el entorno de build.
# No contiene secretos: todo lo que empieza por VITE_ queda incrustado en el JavaScript público.

# URL base de la API (incluye /api/v1). Si se omite, el frontend usa "/api/v1" en su mismo origen,
# lo que exige un proxy inverso que envíe /api al backend (ver README, Despliegue).
# Ejemplo con la API en otro dominio (requiere CORS_ALLOWED_ORIGINS en el backend):
# VITE_API_BASE_URL=https://api.simulador.universidad.edu.co/api/v1
VITE_API_BASE_URL=

# Solo desarrollo (npm run dev / npm run preview): a dónde reenvía Vite las peticiones /api.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

        {
          "name": "Crear caso completo desde CaseDSL (Builder)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cases/full",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "cases",
                "full"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_docente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dslVersion\": \"1.0\",\n  \"caso\": {\n    \"nombre\": \"Conformidad grupal {{run_id}}\",\n    \"desarrolloSituacional\": \"Un grupo de estudiantes debe decidir si reporta una irregularidad observada durante una práctica.\",\n    \"historia\": \"El caso se inspira en los experimentos clásicos de conformidad y presión social.\",\n    \"tiempoEstimadoMin\": 60\n  },\n  \"escenarios\": [\n    {\n      \"titulo\": \"La reunión del grupo\",\n      \"contexto\": \"La mayoría del grupo opina que no vale la pena reportar lo ocurrido.\",\n      \"preguntas\": [\n        {\n          \"enunciado\": \"¿Qué fenómeno describe mejor la presión que siente el estudiante?\",\n          \"criterio\": \"conceptos\",\n          \"opciones\": [\n            {\n              \"texto\": \"Conformidad normativa\",\n              \"esCorrecta\": true,\n              \"justificacion\": \"Se ajusta para ser aceptado por el grupo.\"\n            },\n            {\n              \"texto\": \"Disonancia cognitiva\",\n              \"esCorrecta\": false,\n              \"justificacion\": \"Describe un conflicto interno entre creencias.\"\n            },\n            {\n              \"texto\": \"Efecto halo\",\n              \"esCorrecta\": false,\n              \"justificacion\": \"Es un sesgo de percepción, no de presión social.\"\n            }\n          ]\n        },\n        {\n          \"enunciado\": \"¿Qué acción favorece una decisión ética del grupo?\",\n          \"criterio\": \"aplicacion\",\n          \"opciones\": [\n            {\n              \"texto\": \"Proponer una discusión abierta con evidencias\",\n              \"esCorrecta\": true,\n              \"justificacion\": \"Reduce la ignorancia pluralista.\"\n            },\n            {\n              \"texto\": \"Votar de inmediato sin discutir\",\n              \"esCorrecta\": false,\n              \"justificacion\": \"Refuerza la presión de la mayoría.\"\n            },\n            {\n              \"texto\": \"Aceptar la opinión del líder\",\n              \"esCorrecta\": false,\n              \"justificacion\": \"Favorece la obediencia acrítica.\"\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"rubrica\": {\n    \"escalaMax\": 5.0,\n    \"criterios\": [\n      {\n        \"clave\": \"conceptos\",\n        \"descripcion\": \"Identificación de conceptos de psicología social\",\n        \"peso\": 60,\n        \"niveles\": [\n          {\n            \"nombre\": \"Alto\",\n            \"valor\": 5.0,\n            \"minAciertosPct\": 80\n          },\n          {\n            \"nombre\": \"Medio\",\n            \"valor\": 3.0,\n            \"minAciertosPct\": 50\n          },\n          {\n            \"nombre\": \"Bajo\",\n            \"valor\": 1.0,\n            \"minAciertosPct\": 0\n          }\n        ]\n      },\n      {\n        \"clave\": \"aplicacion\",\n        \"descripcion\": \"Aplicación de los conceptos a la situación\",\n        \"peso\": 40,\n        \"niveles\": [\n          {\n            \"nombre\": \"Alto\",\n            \"valor\": 5.0,\n            \"minAciertosPct\": 80\n          },\n          {\n            \"nombre\": \"Medio\",\n            \"valor\": 3.0,\n            \"minAciertosPct\": 50\n          },\n          {\n            \"nombre\": \"Bajo\",\n            \"valor\": 1.0,\n            \"minAciertosPct\": 0\n          }\n        ]\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Queda en BORRADOR\", () => pm.expect(r.estado).to.eql(\"BORRADOR\"));",
                  "pm.test(\"1 escenario, 2 preguntas, rúbrica con 2 criterios\", () => {",
                  "  pm.expect(r.escenarios).to.have.lengthOf(1);",
                  "  pm.expect(r.escenarios[0].preguntas).to.have.lengthOf(2);",
                  "  pm.expect(r.rubrica.criterios).to.have.lengthOf(2);",
                  "});",
                  "pm.environment.set(\"caso_id\", r.id);",
                  "const [q1, q2] = r.escenarios[0].preguntas;",
                  "pm.environment.set(\"q1_id\", q1.id);",
                  "pm.environment.set(\"q1_correcta_id\", q1.opciones.find(o => o.es_correcta).id);",
                  "pm.environment.set(\"q1_incorrecta_id\", q1.opciones.find(o => !o.es_correcta).id);",
                  "pm.environment.set(\"q2_id\", q2.id);",
                  "pm.environment.set(\"q2_correcta_id\", q2.opciones.find(o => o.es_correcta).id);",
                  "pm.environment.set(\"q2_incorrecta_id\", q2.opciones.find(o => !o.es_correcta).id);"
                ]
              }
            }
          ]
        },

        {
          "name": "Programar sesión (con convocatoria del estudiante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_docente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caso_id\": \"{{caso_id}}\",\n  \"espacio_academico_id\": \"{{espacio_id}}\",\n  \"inicio\": \"{{sesion_inicio}}\",\n  \"fin\": \"{{sesion_fin}}\",\n  \"tiempo_max_min\": 30,\n  \"lugar\": \"Aula 204\",\n  \"mensaje\": \"Traer el material leído en clase.\",\n  \"estudiantes\": [\"{{estudiante_correo}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verifica que las peticiones previas hayan guardado lo necesario.",
                  "const faltan = {",
                  "  token_docente: \"Login docente\",",
                  "  caso_id: \"Crear caso completo desde CaseDSL (Builder) + Publicar caso\",",
                  "  espacio_id: \"Crear espacio académico (admin)\",",
                  "  estudiante_correo: \"Health check + Registrar estudiante (sin contraseña)\",",
                  "};",
                  "const vacias = Object.keys(faltan).filter(k => !pm.environment.get(k));",
                  "if (vacias.length) {",
                  "  throw new Error(\"Faltan variables en el entorno: \" + vacias.map(k => `${k} (ejecute antes: ${faltan[k]})`).join(\"; \"));",
                  "}",
                  "// La sesión empieza hace 2 minutos y termina en 2 horas: así puede iniciarse ya",
                  "// y el límite de ingreso (mitad de la ventana) queda ~1 hora en el futuro.",
                  "const ahora = Date.now();",
                  "pm.environment.set(\"sesion_inicio\", new Date(ahora - 2 * 60 * 1000).toISOString());",
                  "pm.environment.set(\"sesion_fin\", new Date(ahora + 120 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Estado SIN_INICIAR con 1 convocatoria\", () => { pm.expect(r.estado).to.eql(\"SIN_INICIAR\"); pm.expect(r.total_convocatorias).to.eql(1); });",
                  "pm.test(\"Calcula limite_ingreso\", () => pm.expect(r.limite_ingreso).to.be.a(\"string\"));",
                  "pm.environment.set(\"sesion_id\", r.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar convocatorias activas (sin códigos)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",

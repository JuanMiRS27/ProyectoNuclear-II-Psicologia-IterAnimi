                "convocations"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_docente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"No expone codigo_autorizacion\", () => r.forEach(c => pm.expect(c).to.not.have.property(\"codigo_autorizacion\")));",
                  "const propia = r.find(c => c.estudiante.correo === pm.environment.get(\"estudiante_correo\"));",
                  "pm.test(\"Incluye al estudiante 1\", () => pm.expect(propia).to.not.be.undefined);",
                  "pm.environment.set(\"convocatoria_id\", propia.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar código de convocatoria (docente responsable)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{sesion_id}}/convocations/{{convocatoria_id}}/code",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "{{sesion_id}}",
                "convocations",
                "{{convocatoria_id}}",
                "code"
              ]
            },
            "description": "Requiere CONVOCATION_CODE_RETRIEVAL_ENABLED=true en el .env.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_docente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Coincide con el regenerado\", () => pm.expect(r.codigo_autorizacion).to.eql(pm.environment.get(\"codigo_convocatoria\")));",
                  "pm.environment.set(\"codigo_convocatoria\", r.codigo_autorizacion);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{sesion_id}}/start",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "{{sesion_id}}",
                "start"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_docente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado EN_CURSO\", () => pm.expect(pm.response.json().estado).to.eql(\"EN_CURSO\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Login estudiante (suelto)",
      "item": [
        {
          "name": "Login estudiante (suelto)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/student/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "student",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{estudiante_correo}}\",\n  \"codigo\": \"{{codigo_convocatoria}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Ingreso del estudiante con `estudiante_correo` + `codigo_convocatoria` del entorno. Guarda `token_estudiante`. Puede repetirse sola cuando el token venza, mientras la sesión siga EN_CURSO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Token ligado a la sesión\", () => pm.expect(r.sesion_id).to.eql(pm.environment.get(\"sesion_id\")));",
                  "pm.environment.set(\"token_estudiante\", r.access_token);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
            "description": "Requiere un administrador creado con `python -m app.scripts.create_admin`. Configure `admin_correo` y `admin_clave` en el entorno.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{admin_correo}}\",\n  \"clave\": \"{{admin_clave}}\"\n}",
